{
  "name": "@lin_arm/gkd-rules",
  "version": "0.0.1",
  "description": "GKD 第三方订阅规则",
  "keywords": [
    "gkd",
    "subscription",
    "android",
    "跳过广告"
  ],
  "author": "lin_arm",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lin-arm/gkd-Rules.git"
  },
  "type": "module",
  "gkd": {
    "outDir": "dist",
    "file": "gkd.json5",
    "versionFile": "gkd.version.json5",
    "changelog": "CHANGELOG.md",
    "README.md": "README.md"
  },
  "scripts": {
    "postinstall": "simple-git-hooks",
    "format": "prettier --cache --write ./**/*.{js,cjs,mjs,ts,jsx,tsx,json}",
    "lint": "eslint --cache --fix ./**/*.{js,cjs,mjs,ts,jsx,tsx}",
    "check": "tsc --noEmit && tsx ./scripts/check.ts",
    "build": "tsc --noEmit && tsx ./scripts/build.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --config commitlint.config.ts --edit ${1}",
    "pre-push": "pnpm run check"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,jsx,tsx}": [
      "eslint --cache --fix",
      "prettier --cache --write"
    ],
    "*.json": [
      "prettier --cache --write"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "./dist"
  ],
  "dependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@gkd-kit/api": "0.9.3",
    "@gkd-kit/define": "0.0.1",
    "@gkd-kit/tools": "0.8.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "json5": "2.2.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript-eslint": "8.71.0"
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "10.34.6"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "typescript": "6.0.3"
  }
}
