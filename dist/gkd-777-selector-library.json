      "name": "2️⃣内含文字的节点",
      "selector": "[text.length>0 || desc.length>0]",
      "description": "查找含有文字的节点",
      "tags": ["Lin-arm自用"],
      "scope": "global"
    },
    {
      "id": "bb97edd0-a942-493a-a366-678c867ce4f2",
      "name": "3️⃣末尾子节点",
